{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "ignorePaths": [],
  "customDatasources": {
    "charmhub": {
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [`channel-map`.{\"version\": channel.base.channel & \"_\" & channel.base.architecture & \"_\" & $string(revision.revision)}]}"
      ]
    }
  },
  "packageRules": [
    {
      "enabled": false,
      "matchFileNames": ["docs/**"]
    },
    {
      "enabled": true,
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "matchDatasources": [
        "custom.charmhub"
      ],
      "automerge": true,
      "enabled": true
    },
    {
      "matchDatasources": [
        "custom.charmhub"
      ],
      "groupName": "{{packageFileDir}}"
    },
    {
      "enabled": false,
      "matchFileNames": [
        "rockcraft.yaml"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ]
    },
    {
      "groupName": "charm-ci",
      "description": "Keep the opcli git dependency (pyproject.toml/uv.lock) and the canonical/charm-ci reusable workflow refs (.github/workflows) in lockstep, since they must always point at the same charm-ci release.",
      "matchPackageNames": [
        "opcli",
        "canonical/charm-ci",
        "*charm-ci*"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "docker",
      "description": "Update base image references",
      "managerFilePatterns": [
        "/(^|/)rockcraft.yaml$/"
      ],
      "matchStrings": [
        "# renovate: build-base:\\s+(?<depName>[^:]*):(?<currentValue>[^\\s@]*)(@(?<currentDigest>sha256:[0-9a-f]*))?",
        "# renovate: base:\\s+(?<depName>[^:]*):(?<currentValue>[^\\s@]*)(@(?<currentDigest>sha256:[0-9a-f]*))?"
      ],
      "matchStringsStrategy": "any",
      "versioningTemplate": "ubuntu"
    },
    {
      "customType": "regex",
      "description": "Update dependency charm revisions pinned via `# renovate: depName=...` annotations in integration test constants.py and Terraform files (ISD301)",
      "managerFilePatterns": [
        "/(^|/)tests/(integration/)?constants\\.py$/",
        "/\\.tftest\\.hcl$/",
        "/\\.tf$/"
      ],
      "matchStrings": [
        "# renovate: depName=\"(?<depName>.*?)\" channel=\"(?<charmChannel>.*?)\" base=\"(?<base>.*?)\" arch=\"(?<arch>.*?)\"\\s*\\n\\s*\\w+_REVISION = (?<currentValue>\\d+)",
        "# renovate: depName=\"(?<depName>.*?)\" channel=\"(?<charmChannel>.*?)\" base=\"(?<base>.*?)\" arch=\"(?<arch>.*?)\"\\s*\\n\\s*revision\\s*=\\s*(?<currentValue>\\d+)"
      ],
      "matchStringsStrategy": "any",
      "datasourceTemplate": "custom.charmhub",
      "registryUrlTemplate": "https://api.charmhub.io/v2/charms/info/{{depName}}?channel={{charmChannel}}&fields=channel-map",
      "versioningTemplate": "semver-coerced",
      "extractVersionTemplate": "^{{base}}_{{arch}}_(?<version>.*)$"
    }
  ],
  "schedule": [
    "* * * * 0,6"
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  }
}
